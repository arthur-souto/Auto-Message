# Copy this file to `.env` (local dev) or `.env.prod` (production, used by docker-compose.prod.yml)
# and fill in the real values. See documentacao/DOCUMENTACAO.md for details on each variable.

# --- Database (Postgres) ---
# Dev defaults (match docker-compose.yml) are used by the app if these are unset,
# but docker-compose.prod.yml's postgres container always needs POSTGRES_* below.
DB_URL=jdbc:postgresql://localhost:5432/k_db_dev
DB_USERNAME=dev
DB_PASSWORD=dev

# Only read by the postgres image itself (docker-compose.prod.yml), not by the Spring app.
# Keep these in sync with DB_URL/DB_USERNAME/DB_PASSWORD above in production.
POSTGRES_DB=k_db_dev
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Google OAuth2 login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mail (Resend SMTP) ---
RESEND_API_KEY=
MAIL_FROM=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=

# --- Frontend integration ---
REDIRECT_URI=
FRONT_URL=

# --- Account activation ---
ACTIVATE_SECRET=
